# AgentExpress configuration (copy to .env and adjust).
# These are read by src/agentexpress/config.py.

# AWS region hosting your Bedrock models.
AWS_REGION=us-east-1

# Bedrock model ID used by every agent. Must be enabled in your account/region.
# Examples:
#   us.anthropic.claude-3-5-haiku-20241022-v1:0   (fast / cheap)
#   us.anthropic.claude-3-5-sonnet-20241022-v2:0  (higher quality)
AGENTEXPRESS_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# Sampling temperature for all agents (0.0 - 1.0).
AGENTEXPRESS_TEMPERATURE=0.3

# AWS Neptune ontology configuration.
# Use STS AssumeRole and SigV4; do not store AWS access keys here.
NEPTUNE_CLUSTER_ENDPOINT=REPLACE_ME
NEPTUNE_PORT=8182
NEPTUNE_SPARQL_URL=https://REPLACE_ME:8182/sparql
NEPTUNE_OPENCYPHER_URL=https://REPLACE_ME:8182/openCypher
NEPTUNE_AWS_REGION=us-east-1
NEPTUNE_AWS_ACCOUNT_ID=REPLACE_ME
NEPTUNE_IAM_ROLE_NAME=REPLACE_ME
NEPTUNE_IAM_ROLE_ARN=arn:aws:iam::REPLACE_ME:role/REPLACE_ME
NEPTUNE_AUTH_METHOD=sigv4-assume-role


# Neptune ontology metadata.
NEPTUNE_ONTOLOGY_ID=REPLACE_ME
NEPTUNE_ONTOLOGY_NAME="REPLACE_ME"
NEPTUNE_NAMESPACE_URI=http://REPLACE_ME/ontology/namespace#
NEPTUNE_GRAPH_URI=http://REPLACE_ME/graph


# Databricks workspace.
DATABRICKS_HOST=https://REPLACE_ME.cloud.databricks.com
DATABRICKS_WORKSPACE_URL=https://REPLACE_ME.cloud.databricks.com
DATABRICKS_WORKSPACE_HOSTNAME=REPLACE_ME.cloud.databricks.com


# Databricks Unity Catalog and OMDA registry.
DATABRICKS_UC_CATALOG=REPLACE_ME
DATABRICKS_UC_SCHEMA=REPLACE_ME
DATABRICKS_UC_SCHEMA_PATH=REPLACE_ME.REPLACE_ME
DATABRICKS_REGISTRY_TABLE=REPLACE_ME.REPLACE_ME.omda_ontology_mapping
DATABRICKS_REGISTRY_ENTRY_COUNT=0
DATABRICKS_REGISTRY_TABLE_COUNT=0
DATABRICKS_UNIVERSAL_JOIN_KEY=REPLACE_ME

# Databricks Vector Search.
DATABRICKS_VECTOR_ENDPOINT=REPLACE_ME
DATABRICKS_VECTOR_INDEX=REPLACE_ME.REPLACE_ME.REPLACE_ME

# Databricks Model Serving endpoint name.
DATABRICKS_MODEL_SERVING_ENDPOINT=REPLACE_ME
DATABRICKS_LLM_ENDPOINT=REPLACE_ME


# Databricks authentication. Put the real PAT only in .env or a secret manager.
DATABRICKS_TOKEN=REPLACE_ME

DATABRICKS_TOKEN_ID=REPLACE_ME


# Databricks resource allowlist — applications must fail closed outside this scope.
DATABRICKS_ENFORCE_RESOURCE_ALLOWLIST=true
DATABRICKS_ALLOWED_WORKSPACE_HOSTNAME=REPLACE_ME.cloud.databricks.com
DATABRICKS_ALLOWED_UC_CATALOG=REPLACE_ME
DATABRICKS_ALLOWED_UC_SCHEMA=REPLACE_ME
DATABRICKS_ALLOWED_UC_SCHEMA_PATH=REPLACE_ME.REPLACE_ME
DATABRICKS_ALLOWED_REGISTRY_TABLE=REPLACE_ME.REPLACE_ME.omda_ontology_mapping
DATABRICKS_ALLOWED_CLUSTER_NAME=REPLACE_ME
