# AgentExpress Control Plane — environment configuration
#
# Copy to `.env.local` (git-ignored) and adjust. NEVER put AWS credentials in
# this file or any committed file. The app uses the AWS SDK's default
# credential provider chain (environment, SSO, shared config, or the
# instance/ECS/Pod role). There is deliberately no access-key setting here.

# ---------------------------------------------------------------------------
# Execution mode: "local" (default) or "aws".
#   local -> in-memory store only, no AWS calls, no cost.
#   aws   -> the /aws-resources page + /api/aws/* run live read-only AWS calls.
# ---------------------------------------------------------------------------
AWS_EXECUTION_MODE=local

# ---------------------------------------------------------------------------
# AWS region. Required only when AWS_EXECUTION_MODE=aws.
# Resolved ONLY from AWS_REGION or AWS_DEFAULT_REGION — there is no hardcoded
# fallback. If neither is set in aws mode, the API returns a clear
# configuration error (REGION_UNSET).
# ---------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1

# ---------------------------------------------------------------------------
# Optional base path if serving the UI behind a prefix (e.g. a reverse proxy).
# Leave unset for direct access / code-server Ports-panel forwarding.
#   BASE_PATH      -> Next.js basePath + assetPrefix (server + build)
#   NEXT_PUBLIC_BASE_PATH -> client fetch prefix used by src/lib/api.ts
# For the /agent-control deployment, set BOTH to /agent-control.
# ---------------------------------------------------------------------------
# BASE_PATH=/agent-control
# NEXT_PUBLIC_BASE_PATH=/agent-control

# ---------------------------------------------------------------------------
# Graph control-plane store. Governs GraphSources, build runs, mapping
# proposals, approvals, and published mapping versions.
#   GRAPH_CONTROL_STORE = local (default) | dynamodb
#     local    -> in-memory store, no AWS, no network, no cost (offline/tests).
#     dynamodb -> single-table DynamoDB adapter. Fails CLOSED if misconfigured
#                 (it never silently falls back to local).
#
# DynamoDB mode prerequisites (you provision these out-of-band — the app does
# NOT create the table and makes no network calls at import):
#   - A DynamoDB table named by GRAPH_CONTROL_TABLE with:
#       * Primary key:  PK (HASH, String), SK (RANGE, String)
#       * GSI "GSI1":   GSI1PK (HASH), GSI1SK (RANGE)   -- tenant queries
#       * GSI "GSI2":   GSI2PK (HASH), GSI2SK (RANGE)   -- status queries
#   - AWS_REGION or AWS_DEFAULT_REGION set (no hardcoded fallback).
#   - Credentials via the SDK default provider chain (env/SSO/role). NEVER put
#     credentials here — only connection/secret *references* are ever stored.
# ---------------------------------------------------------------------------
GRAPH_CONTROL_STORE=local
# GRAPH_CONTROL_TABLE=agentexpress-graph-control

# ---------------------------------------------------------------------------
# Optional bearer token for the graph serving endpoint (preview-only setups
# don't need it). Resolved at runtime; never stored in any record.
# ---------------------------------------------------------------------------
# GRAPH_SERVING_TOKEN=
# DATABRICKS_TOKEN=